VITE_MAPTILER_API_KEY=your_maptiler_api_key_here

# Build/release identity. CI can override these with the tag, commit SHA,
# and UTC build timestamp.
BUILD_VERSION=dev
BUILD_SHA=unknown
BUILD_DATE=unknown

# Backend dataset discovery. NETCDF_PATH is tried first; if it is missing,
# the API scans NETCDF_DATA_DIR for a usable WRF/NetCDF/GRIB file.
NETCDF_PATH=data/wrfout_d01_2026-09-02_00:00:00
NETCDF_DATA_DIR=data

# Optional backend API protection. Leave empty for local browser-only demos.
# When set, private API endpoints require X-API-Key or Authorization: Bearer.
API_KEY=
CORS_ORIGINS=http://localhost,http://127.0.0.1:5173
LOG_LEVEL=INFO
RATE_LIMIT_PER_MINUTE=0
RATE_LIMIT_WINDOW_SECONDS=60

# COG/TiTiler integration.
COG_ROOT=/cog
ETL_AUTO=true
ETL_DIR=/app/etl

# Local Docker defaults for a MacBook Pro M2 with 32 GB RAM.
GUNICORN_WORKERS=1
TILE_CACHE_SIZE=512
WIND_CACHE_SIZE=64
